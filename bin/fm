#!/usr/bin/env bash
# bin/fm - short alias for the Firstmate topic launcher.
set -u

resolve_script_path() {
  local source=$1 dir target
  while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd) || return 1
    target=$(readlink "$source") || return 1
    case "$target" in
      /*) source=$target ;;
      *) source=$dir/$target ;;
    esac
  done
  dir=$(cd -P "$(dirname "$source")" && pwd) || return 1
  printf '%s/%s\n' "$dir" "${source##*/}"
}

SCRIPT=$(resolve_script_path "${BASH_SOURCE[0]}") \
  || { printf 'error: could not resolve fm launcher path\n' >&2; exit 1; }
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
exec "$DIR/firstmate" "$@"
