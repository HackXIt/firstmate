#!/usr/bin/env bash
# bin/firstmate - launch an isolated Firstmate topic home from the shared checkout.
set -u

resolve_script_path() {
  local source=$1 dir target
  while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd) || return 1
    target=$(readlink "$source") || return 1
    case "$target" in
      /*) source=$target ;;
      *) source=$dir/$target ;;
    esac
  done
  dir=$(cd -P "$(dirname "$source")" && pwd) || return 1
  printf '%s/%s\n' "$dir" "${source##*/}"
}

FIRSTMATE_SCRIPT=$(resolve_script_path "${BASH_SOURCE[0]}") \
  || { printf 'error: could not resolve firstmate launcher path\n' >&2; exit 1; }
FIRSTMATE_ROOT="$(cd "$(dirname "$FIRSTMATE_SCRIPT")/.." && pwd)"
FIRSTMATE_EXT_GUARD="$FIRSTMATE_ROOT/.pi/extensions/fm-primary-turnend-guard.ts"
FIRSTMATE_EXT_WATCH="$FIRSTMATE_ROOT/.pi/extensions/fm-primary-pi-watch.ts"

usage() {
  cat >&2 <<'EOF'
usage: firstmate <topic-or-name>
       fm <topic-or-name>

A topic is required for every public Firstmate launch.
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

trim_topic() {
  printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

slug_topic() {
  local topic=$1 slug
  slug=$(printf '%s' "$topic" \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//') || return 1
  [ -n "$slug" ] || return 1
  printf '%s\n' "$slug"
}

topic_key() {
  local topic=$1 slug digest
  slug=$(slug_topic "$topic") || return 1
  if [ "$topic" = "$slug" ]; then
    printf '%s\n' "$slug"
    return 0
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    digest=$(printf '%s' "$topic" | sha256sum) || return 1
  elif command -v shasum >/dev/null 2>&1; then
    digest=$(printf '%s' "$topic" | shasum -a 256) || return 1
  else
    fail "sha256sum or shasum is required to isolate normalized topic names"
  fi
  digest=${digest%% *}
  printf '%s__%.12s\n' "$slug" "$digest"
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

write_topic_home_marker() {
  local home=$1 herdr_session=$2 marker temporary expected legacy current unbound
  marker="$home/.fm-topic-home"
  expected=$(printf 'version=2\nhome=%s\nroot=%s\nherdr_session=%s\n' \
    "$home" "$FIRSTMATE_ROOT" "$herdr_session") || return 1
  legacy=$(printf 'version=1\nhome=%s\nroot=%s\n' "$home" "$FIRSTMATE_ROOT") || return 1
  unbound=$(printf 'version=2\nhome=%s\nroot=%s\nherdr_session=\n' \
    "$home" "$FIRSTMATE_ROOT") || return 1
  if [ -e "$marker" ] || [ -L "$marker" ]; then
    [ -f "$marker" ] && [ ! -L "$marker" ] \
      || fail "topic-home marker is not a regular file: $marker"
    current=$(cat "$marker") || fail "could not read topic-home marker: $marker"
    [ "$current" = "$expected" ] && return 0
    if [ "$current" != "$legacy" ] \
       && { [ -z "$herdr_session" ] || [ "$current" != "$unbound" ]; }; then
      fail "topic-home marker does not match this home, Firstmate checkout, and Herdr session: $marker"
    fi
  fi
  temporary="$marker.$$.tmp"
  (umask 077 && set -o noclobber && printf '%s\n' "$expected" > "$temporary") \
    || { rm -f "$temporary"; fail "could not create topic-home marker under $home"; }
  mv "$temporary" "$marker" \
    || { rm -f "$temporary"; fail "could not publish topic-home marker under $home"; }
}

ensure_pi_topic_home_recovery_extension() {
  local source target_dir target resolved
  source="$FIRSTMATE_ROOT/.pi/extensions/fm-topic-home-recovery.ts"
  target_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions"
  target="$target_dir/fm-topic-home-recovery.ts"
  [ -f "$source" ] && [ ! -L "$source" ] \
    || fail "Firstmate Pi recovery extension is missing: $source"
  mkdir -p "$target_dir" \
    || fail "could not create Pi's extension directory: $target_dir"
  if [ -e "$target" ] || [ -L "$target" ]; then
    [ -L "$target" ] \
      || fail "Pi recovery extension path is occupied by another file: $target"
    resolved=$(resolve_script_path "$target") \
      || fail "Pi recovery extension link is broken: $target"
    [ "$resolved" = "$source" ] \
      || fail "Pi recovery extension link points at another checkout: $target"
    return 0
  fi
  ln -s "$source" "$target" \
    || fail "could not install Pi's Firstmate topic-recovery extension: $target"
}

build_pi_command() {
  local topic=$1 home=$2 herdr_session=$3 session_dir name cmd
  session_dir="$home/pi-sessions"
  name="firstmate: $topic"
  cmd="cd $(shell_quote "$FIRSTMATE_ROOT") && env FM_PI_TOPIC_LAUNCH=1 FM_HOME=$(shell_quote "$home") FM_ROOT_OVERRIDE=$(shell_quote "$FIRSTMATE_ROOT") HERDR_SESSION=$(shell_quote "$herdr_session") FM_STATE_OVERRIDE=$(shell_quote "${FM_STATE_OVERRIDE:-$home/state}") pi"
  cmd="$cmd --session-dir $(shell_quote "$session_dir") --name $(shell_quote "$name")"
  cmd="$cmd -e $(shell_quote "$FIRSTMATE_EXT_GUARD") -e $(shell_quote "$FIRSTMATE_EXT_WATCH")"
  printf '%s\n' "$cmd"
}

run_pi_direct() {
  local topic=$1 home=$2 herdr_session=${3:-}
  cd "$FIRSTMATE_ROOT" || fail "could not enter Firstmate checkout: $FIRSTMATE_ROOT"
  exec env \
    FM_PI_TOPIC_LAUNCH=1 \
    FM_HOME="$home" \
    FM_ROOT_OVERRIDE="$FIRSTMATE_ROOT" \
    HERDR_SESSION="$herdr_session" \
    pi \
      --session-dir "$home/pi-sessions" \
      --name "firstmate: $topic" \
      -e "$FIRSTMATE_EXT_GUARD" \
      -e "$FIRSTMATE_EXT_WATCH"
}

herdr_scoped() {
  local session=$1
  shift
  HERDR_SESSION="$session" herdr "$@" --session "$session"
}

inside_herdr() {
  [ "${HERDR_ENV:-}" = "1" ]
}

current_herdr_workspace_claimable() {
  local session=$1 tabs pane
  [ -n "${HERDR_PANE_ID:-}" ] || return 1
  pane=$(herdr_scoped "$session" pane get "$HERDR_PANE_ID" 2>/dev/null) || return 1
  CURRENT_HERDR_WORKSPACE_ID=$(printf '%s' "$pane" | jq -er --arg pane "$HERDR_PANE_ID" '
    select(.result.pane.pane_id == $pane) | .result.pane.workspace_id | select(type == "string" and length > 0)
  ' 2>/dev/null) || return 1
  CURRENT_HERDR_TAB_ID=$(printf '%s' "$pane" | jq -er --arg pane "$HERDR_PANE_ID" '
    select(.result.pane.pane_id == $pane) | .result.pane.tab_id | select(type == "string" and length > 0)
  ' 2>/dev/null) || return 1
  tabs=$(herdr_scoped "$session" tab list --workspace "$CURRENT_HERDR_WORKSPACE_ID" 2>/dev/null) || return 1
  printf '%s' "$tabs" | jq -e --arg tab "$CURRENT_HERDR_TAB_ID" '
    (.result.tabs | type) == "array"
    and (.result.tabs | length) == 1
    and .result.tabs[0].tab_id == $tab
    and .result.tabs[0].pane_count == 1
  ' >/dev/null 2>&1 || return 1
}

reuse_current_herdr_workspace() {
  local topic=$1 home=$2 session=$3 workspace_label=$4
  herdr_scoped "$session" workspace rename "$CURRENT_HERDR_WORKSPACE_ID" "$workspace_label" >/dev/null \
    || fail "could not name the current Herdr workspace '$workspace_label'"
  herdr_scoped "$session" tab rename "$CURRENT_HERDR_TAB_ID" firstmate >/dev/null \
    || fail "could not name the current Herdr tab 'firstmate'"
  herdr_scoped "$session" pane rename "$HERDR_PANE_ID" firstmate >/dev/null \
    || fail "could not name the current Herdr pane 'firstmate'"
  run_pi_direct "$topic" "$home" "$session"
}

run_with_herdr() {
  local topic=$1 slug=$2 home=$3 session=$4 workspace_label out tab_id pane_id command
  workspace_label="firstmate-$slug"

  command -v jq >/dev/null 2>&1 || fail "Herdr is available but jq is missing; install jq or remove Herdr from PATH to launch Pi directly"

  if inside_herdr && current_herdr_workspace_claimable "$session"; then
    reuse_current_herdr_workspace "$topic" "$home" "$session" "$workspace_label"
  fi

  out=$(herdr_scoped "$session" workspace create --cwd "$FIRSTMATE_ROOT" --label "$workspace_label") \
    || fail "could not create Herdr workspace '$workspace_label' in session '$session'"
  tab_id=$(printf '%s' "$out" | jq -r '.result.tab.tab_id // empty' 2>/dev/null) \
    || fail "could not parse Herdr workspace creation output"
  pane_id=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null) \
    || fail "could not parse Herdr workspace creation output"
  [ -n "$tab_id" ] || fail "Herdr workspace creation did not return a tab id"
  [ -n "$pane_id" ] || fail "Herdr workspace creation did not return a root pane id"

  herdr_scoped "$session" tab rename "$tab_id" firstmate >/dev/null \
    || fail "could not name the Herdr tab 'firstmate'"
  herdr_scoped "$session" pane rename "$pane_id" firstmate >/dev/null \
    || fail "could not name the Herdr pane 'firstmate'"

  command=$(build_pi_command "$topic" "$home" "$session")
  herdr_scoped "$session" pane run "$pane_id" "$command" \
    || fail "could not start Pi in Herdr workspace '$workspace_label'"

  if inside_herdr; then
    printf 'Started Firstmate topic %s in Herdr workspace %s.\n' "$topic" "$workspace_label"
    return 0
  fi

  exec herdr --session "$session"
}

main() {
  local topic raw_topic slug base default_base home herdr_session=""
  case "${1:-}" in
    -h|--help|help)
      usage
      exit 0
      ;;
  esac

  if [ "$#" -gt 0 ]; then
    raw_topic="$*"
  else
    usage
    exit 2
  fi

  topic=$(trim_topic "$raw_topic")
  [ -n "$topic" ] || { usage; exit 2; }
  slug=$(topic_key "$topic") || fail "topic must contain at least one ASCII letter or digit"

  default_base="$HOME/.local/share/firstmate"
  base=${FIRSTMATE_HOME_BASE:-$default_base}
  home="$base/$slug"
  mkdir -p "$home/config" "$home/data" "$home/state" "$home/projects" "$home/pi-sessions" \
    || fail "could not create Firstmate home directories under $home"
  home=$(CDPATH='' cd -- "$home" && pwd -P) \
    || fail "could not resolve Firstmate topic home: $home"
  command -v pi >/dev/null 2>&1 || fail "pi is not installed or not on PATH"

  if command -v herdr >/dev/null 2>&1; then
    if inside_herdr; then
      herdr_session=${HERDR_SESSION:-default}
    else
      herdr_session="firstmate-$slug"
    fi
  fi
  write_topic_home_marker "$home" "$herdr_session"
  if [ -n "$herdr_session" ]; then
    . "$FIRSTMATE_ROOT/bin/fm-pi-topic-state-lib.sh"
    FM_STATE_OVERRIDE=$(CDPATH='' cd -- "${FM_STATE_OVERRIDE:-$home/state}" && pwd -P) \
      || fail "could not resolve Pi topic state directory"
    export FM_STATE_OVERRIDE
    fm_pi_topic_state_bind "$home" "$FIRSTMATE_ROOT" "$herdr_session" "$FM_STATE_OVERRIDE" || exit 1
  fi
  ensure_pi_topic_home_recovery_extension

  if [ -n "$herdr_session" ]; then
    run_with_herdr "$topic" "$slug" "$home" "$herdr_session"
    return $?
  fi

  run_pi_direct "$topic" "$home" ""
}

main "$@"
